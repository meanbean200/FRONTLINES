{
  "name": "frontlines-battlefield-sandbox",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "assets:house": "tsx scripts/build-house.ts",
    "assets:house-two": "tsx scripts/build-two-story-house.ts",
    "assets:truck": "tsx scripts/build-truck.ts",
    "assets:weapons": "tsx scripts/build-weapons.ts",
    "assets:soldier": "tsx scripts/build-soldier.ts",
    "dev": "vite",
    "dev:author": "vite --config vite.dev.config.ts --open /dev.html",
    "build:dev": "tsc -p tsconfig.dev.json && vite build --config vite.dev.config.ts",
    "build": "tsc -b && vite build && node scripts/build-standalone.mjs",
    "standalone": "tsc -b && node scripts/build-standalone.mjs",
    "test:launch": "node scripts/qa-file-boot.mjs",
    "test:packaging": "node --test scripts/test-standalone.mjs",
    "preview": "vite preview",
    "test": "vitest run --maxWorkers=2",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "onnxruntime-web": "^1.30.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@playwright/test": "^1.55.1",
    "@types/three": "^0.180.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.2",
    "vite": "^7.1.7",
    "vitest": "^3.2.4"
  }
}
